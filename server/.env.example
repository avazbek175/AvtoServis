# --- App ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# Origin(s) allowed to send credentialed requests to the API. Comma/space separated.
# REQUIRED when NODE_ENV=production (the server refuses to boot without it).
# In development any localhost port is allowed automatically.
CLIENT_ORIGIN=http://localhost:5173

# --- Reverse proxy ---
# Set only when the API runs behind nginx/Caddy/Cloudflare, e.g. TRUST_PROXY=1
# (number of proxy hops) or TRUST_PROXY=loopback. Leave empty when exposed directly:
# with an empty value X-Forwarded-For is ignored, so clients cannot spoof their IP
# in the login rate limiter.
TRUST_PROXY=

# --- Login rate limiting ---
# Failed logins per account within LOGIN_RATE_WINDOW_MS.
LOGIN_RATE_LIMIT_MAX=10
# Per-IP limit; defaults to LOGIN_RATE_LIMIT_MAX * 5 so that one attacker cannot
# lock out every account, while credential stuffing from a single host is still capped.
LOGIN_RATE_LIMIT_IP_MAX=
LOGIN_RATE_WINDOW_MS=900000

# --- Sessions ---
# Optional. Leave empty locally: the server then generates server/data/secret.key.
# REQUIRED on Vercel / any multi-instance host, where the local filesystem is not
# shared: without it every instance would sign cookies with a different key and
# users would be logged out at random. Generate with: openssl rand -hex 48
JWT_SECRET=

# --- Database (PostgreSQL) ---
# REQUIRED. Connection string for PostgreSQL; there is no SQLite fallback.
# Local dev example: postgresql://user:password@127.0.0.1:5432/avtoservis
# Managed hosts (Neon / Supabase / Vercel Postgres) work too.
DATABASE_URL=
# Managed PostgreSQL requires TLS. Use `disable` for a local cluster without it;
# when left empty the server enables TLS for remote hosts and disables it for
# localhost/socket connections.
DATABASE_SSL=
# Connection pool sizing for serverless. Keep the total across all instances
# below the provider's connection limit (e.g. 10 per instance).
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=10000
# Backoff before a failed cold start retries migrate+seed. A failing instance
# answers 503 while it retries, then recovers on its own, so a brief provider
# failover does not poison the whole instance.
DB_STARTUP_RETRY_MS=1000
DB_STARTUP_RETRY_MAX_MS=30000

# --- First-run setup guard ---
# Password protecting POST /api/auth/setup, used only while no super admin exists.
# REQUIRED when NODE_ENV=production, otherwise setup refuses to run.
# Send it as: Authorization: Bearer <value>   or   X-Setup-Secret: <value>
SETUP_SECRET=

# --- Filesystem locations ---
# Optional overrides, mainly for serverless hosts. The application directory is
# read-only on Vercel, so point both at a writable path (e.g. /tmp/...).
# Note: nothing there is durable or shared between instances, which is why media
# must go to R2 and the database must be a managed PostgreSQL.
DATA_DIR=
UPLOADS_DIR=

# --- Cloudflare R2 (persistent image storage) ---
# Copy this file to server/.env and fill in real values on the server only.
# NEVER commit real credentials. R2 keys stay server-side; they are never
# sent to the frontend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=avtoservis
R2_ENDPOINT=https://c74c7745a45a0d3884d7ce45757cd130.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-48b2e4d326da4e639ade1ce29aee7eae.r2.dev

# Optional but recommended: a SECOND bucket with public access disabled.
# Work-log images may belong to private work logs, so they are stored under the
# `work/` prefix here and served only through /api/workimages/:filename after a
# per-work-log authorization check. Leaving this empty keeps those objects in the
# public bucket (still behind the API check, but a leaked URL would expose them).
# Create the bucket in the Cloudflare dashboard and do NOT enable public access.
R2_PRIVATE_BUCKET_NAME=